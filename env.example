# Supabase Configuration
# Copy this file to .env.local and fill in your Supabase project details

NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Example:
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Cloudinary Configuration
# Used for product image uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset
# Optional: change the upload folder name used in Cloudinary
NEXT_PUBLIC_CLOUDINARY_FOLDER=products

# Google Gemini AI Configuration
# Required for SEO content generation feature
GEMINI_API_KEY=your_gemini_api_key_here

# Example:
# GEMINI_API_KEY=AIzaSyABC123...
# Get your API key from: https://makersuite.google.com/app/apikey
